                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="conf3" value="&lt;b&gt;Платежные данные клиентов и собственников&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Риск:&lt;/b&gt; Утечка данных&lt;br&gt;&lt;b&gt;Оценка:&lt;/b&gt; &lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Данные карт покупателей (при бронировании) и собственников (оплата ЖКХ). Утечка - прямые финансовые потери, мошенничество, штрафы PCI DSS&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingTop=10;spacingBottom=10;spacingLeft=15;spacingRight=15;" parent="1" vertex="1">
