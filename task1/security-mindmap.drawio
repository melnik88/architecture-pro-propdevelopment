                <mxCell id="secret2" value="&lt;b&gt;Данные Active Directory&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Риск:&lt;/b&gt; Утечка данных&lt;br&gt;&lt;b&gt;Оценка:&lt;/b&gt; &lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Компрометация учетных данных дает доступ ко всем системам компании&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=11;spacingTop=10;spacingBottom=10;spacingLeft=15;spacingRight=15;" parent="1" vertex="1">
