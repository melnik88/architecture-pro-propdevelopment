                <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#d6b656;" parent="1" source="central" target="confidential" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="conf1" value="&lt;b&gt;Данные клиентов-покупателей (CRM)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Риск:&lt;/b&gt; Утечка данных&lt;br&gt;&lt;b&gt;Оценка:&lt;/b&gt; &lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Данные потенциальных покупателей: контакты, предпочтения, история просмотров. Утечка влечет штрафы по GDPR/152-ФЗ и потерю доверия клиентов&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingTop=10;spacingBottom=10;spacingLeft=15;spacingRight=15;" parent="1" vertex="1">
                    <mxGeometry x="-20" y="860" width="200" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;exitPerimeter=0;" parent="1" source="confidential" target="conf1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="conf2" value="&lt;b&gt;Данные собственников недвижимости&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Риск:&lt;/b&gt; Утечка данных&lt;br&gt;&lt;b&gt;Оценка:&lt;/b&gt; &lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Данные владельцев объектов: паспортные данные, адреса, договоры, финансовые обязательства по ЖКХ. Утечка - уголовная ответственность по ст. 137 УК РФ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingTop=10;spacingBottom=10;spacingLeft=15;spacingRight=15;" parent="1" vertex="1">
                    <mxGeometry x="210" y="860" width="200" height="180" as="geometry"/>
