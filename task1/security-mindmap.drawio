                <mxCell id="confidential" value="&lt;b&gt;Конфиденциальные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;spacingTop=8;spacingBottom=8;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
